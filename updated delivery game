//keeps packages to spawn on road only//

function isOnRoad(object) {

    return roads.some(road =>
        isColliding(object, road)
    );

}

function isInsideBuilding(object) {

    return buildings.some(building => {

        // Electric station can be entered

        if (building.recharge) {

            return false;

        }

        return isColliding(
            object,
            building
        );

    });

}

function isValidPackagePosition(object, destination) {

    // Package must be on a road

    if (!isOnRoad(object)) {

        return false;

    }

    // Package cannot be inside buildings

    if (isInsideBuilding(object)) {

        return false;

    }

    // Package cannot spawn at destination

    if (
        destination &&
        isColliding(object, destination)
    ) {

        return false;

    }

    return true;

}

