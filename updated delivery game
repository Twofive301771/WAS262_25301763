//update//

function update(deltaTime) {

    //game timer//

    timeRemaining -=
        deltaTime;

    if (
        timeRemaining <= 0
    ) {

        timeRemaining = 0;

        gameState =
            "timesUp";

        player.velocityX = 0;

        player.velocityY = 0;

        return;

    }

    //teleport message when battery low//

    if (
        teleportMessageTimer > 0
    ) {

        teleportMessageTimer -=
            deltaTime;

        if (
            teleportMessageTimer <= 0
        ) {

            teleportMessageTimer = 0;

            teleportMessage = "";

        }

    }

    player.update(
        deltaTime
    );

    rechargePlayer(
        deltaTime
    );

    checkPackagePickup();

    checkDelivery();

}

//restarting the game when over

function restartGame() {

    timeRemaining =
        GAME_DURATION;

    score = 0;

    deliveries = 0;

    gameState =
        "playing";

    teleportMessage = "";

    teleportMessageTimer = 0;

    player.reset(
        120,
        220
    );

    respawnPackage();

    // Prevent huge delta

    lastTime =
        performance.now();

}

