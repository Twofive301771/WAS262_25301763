//player//

class PlayerVehicle {

    constructor(x, y) {

        this.x = x;

        this.y = y;

        this.width = 18;

        this.height = 18;

        // Physics

        this.velocityX = 0;

        this.velocityY = 0;

        this.acceleration =
            PLAYER_ACCELERATION;

        this.maxSpeed =
            PLAYER_SPEED;

        this.drag =
            PLAYER_DRAG;

        // Direction

        this.angle = 0;

        // Battery

        this.battery =
            MAX_BATTERY;

        this.maxBattery =
            MAX_BATTERY;

        this.energyConsumption =
            ENERGY_CONSUMPTION;

        // Package

        this.carryingPackage =
            false;

    }

    //input on wasd//

    getInputDirection() {

        let directionX = 0;

        let directionY = 0;

        if (
            keys.has("arrowup") ||
            keys.has("w")
        ) {

            directionY -= 1;

        }

        if (
            keys.has("arrowdown") ||
            keys.has("s")
        ) {

            directionY += 1;

        }

        if (
            keys.has("arrowleft") ||
            keys.has("a")
        ) {

            directionX -= 1;

        }

        if (
            keys.has("arrowright") ||
            keys.has("d")
        ) {

            directionX += 1;

        }

        return {

            x: directionX,

            y: directionY

        };

    }

    //movement physics//

    update(deltaTime) {

        const direction =
            this.getInputDirection();

        const moving =
            direction.x !== 0 ||
            direction.y !== 0;

        //movement//

        if (
            moving &&
            this.battery > 0
        ) {

            // Normalize diagonal movement

            const length =
                Math.hypot(
                    direction.x,
                    direction.y
                );

            direction.x /=
                length;

            direction.y /=
                length;

            // Calculate movement angle

            this.angle =
                Math.atan2(
                    direction.y,
                    direction.x
                );

            // Trigonometry

            const cosAngle =
                Math.cos(this.angle);

            const sinAngle =
                Math.sin(this.angle);

            // Acceleration

            this.velocityX +=
                cosAngle *
                this.acceleration *
                deltaTime;

            this.velocityY +=
                sinAngle *
                this.acceleration *
                deltaTime;

        }

        //limit player speed//

        const speed =
            Math.hypot(
                this.velocityX,
                this.velocityY
            );

        if (
            speed >
            this.maxSpeed
        ) {

            const scale =
                this.maxSpeed /
                speed;

            this.velocityX *=
                scale;

            this.velocityY *=
                scale;

        }

        //movement and collision//

        if (
            this.battery > 0
        ) {

            this.moveWithCollision(

                this.velocityX *
                deltaTime,

                this.velocityY *
                deltaTime

            );

        }

        //friction//

        const dragAmount =
            Math.pow(
                this.drag,
                deltaTime * 60
            );

        this.velocityX *=
            dragAmount;

        this.velocityY *=
            dragAmount;

        //battery charge//

        if (
            moving &&
            this.battery > 0
        ) {

            this.battery -=
                this.energyConsumption *
                deltaTime;

            if (
                this.battery <= 0
            ) {

                this.battery = 0;

                this.velocityX = 0;

                this.velocityY = 0;

                teleportMessage =
                    "Battery empty! Returning to recharge station";

                teleportMessageTimer =
                    2.5;

                this.returnToChargingZone();

            }

        }

        //keep player from leaving the screen//

        keepPlayerInsideCanvas();

    }

    //movement with collision//

    moveWithCollision(dx, dy) {

        // Horizontal

        this.x += dx;

        if (
            this.collidesWithBuilding()
        ) {

            this.x -= dx;

            this.velocityX = 0;

        }

        // Vertical

        this.y += dy;

        if (
            this.collidesWithBuilding()
        ) {

            this.y -= dy;

            this.velocityY = 0;

        }

    }

    collidesWithBuilding() {

        return buildings.some(
            building => {

                // Electric grid is accessible

                if (
                    building.recharge
                ) {

                    return false;

                }

                return isColliding(
                    this,
                    building
                );

            }
        );

    }

    //teleport to electric zone//

    returnToChargingZone() {

        this.x =
            chargeZone.x +
            chargeZone.width / 2 -
            this.width / 2;

        this.y =
            chargeZone.y +
            chargeZone.height / 2 -
            this.height / 2;

        this.velocityX = 0;

        this.velocityY = 0;

        this.battery =
            this.maxBattery;

    }

    //reset when pressed//

    reset(x, y) {

        this.x = x;

        this.y = y;

        this.velocityX = 0;

        this.velocityY = 0;

        this.angle = 0;

        this.battery =
            this.maxBattery;

        this.carryingPackage =
            false;

    }

}

//current player//

const player =
    new PlayerVehicle(
        120,
        220
    );

//keep player from leaving screen//

function keepPlayerInsideCanvas() {

    if (
        player.x < 0
    ) {

        player.x = 0;

        player.velocityX = 0;

    }

    if (
        player.y < 0
    ) {

        player.y = 0;

        player.velocityY = 0;

    }

    if (
        player.x +
        player.width >
        canvas.width
    ) {

        player.x =
            canvas.width -
            player.width;

        player.velocityX = 0;

    }

    if (
        player.y +
        player.height >
        canvas.height
    ) {

        player.y =
            canvas.height -
            player.height;

        player.velocityY = 0;

    }

}

//drawing the town//

function drawTown() {

    // Grass

    context.fillStyle =
        "#7fb069";

    context.fillRect(
        0,
        0,
        canvas.width,
        canvas.height
    );

    // Roads

    context.fillStyle =
        "#555";

    for (
        const road of roads
    ) {

        context.fillRect(
            road.x,
            road.y,
            road.width,
            road.height
        );

    }

    // Road markings

    context.strokeStyle =
        "#f5d76e";

    context.lineWidth = 3;

    context.setLineDash([
        15,
        15
    ]);

    for (
        const road of roads
    ) {

        // Horizontal

        if (
            road.width >
            road.height
        ) {

            const centerY =
                road.y +
                road.height / 2;

            context.beginPath();

            context.moveTo(
                road.x,
                centerY
            );

            context.lineTo(
                road.x +
                road.width,
                centerY
            );

            context.stroke();

        }

        // Vertical

        else {

            const centerX =
                road.x +
                road.width / 2;

            context.beginPath();

            context.moveTo(
                centerX,
                road.y
            );

            context.lineTo(
                centerX,
                road.y +
                road.height
            );

            context.stroke();

        }

    }

    context.setLineDash([]);

}

