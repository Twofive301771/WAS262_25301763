//game loops//

function gameLoop(timestamp) {

    // First frame

    if (
        lastTime === 0
    ) {

        lastTime =
            timestamp;

    }

    // Limit delta time

    const deltaTime =
        Math.min(
            (
                timestamp -
                lastTime
            ) / 1000,
            0.05
        );

    lastTime =
        timestamp;

    // Clear canvas

    context.clearRect(
        0,
        0,
        canvas.width,
        canvas.height
    );

    //game states//

    switch (
    gameState
    ) {

        case "playing":

            update(
                deltaTime
            );

            drawGame();

            break;

        case "timesUp":

            drawTimeUpGame();

            break;

        case "results":

            drawResultsScreen();

            break;

    }

    requestAnimationFrame(
        gameLoop
    );

}

//game start//

respawnPackage();

requestAnimationFrame(
    gameLoop
);

