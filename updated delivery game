//function to draw the player//

function drawPlayer() {

    context.save();

    // Move origin to vehicle centre

    context.translate(
        player.x +
        player.width / 2,
        player.y +
        player.height / 2
    );

    // Rotate vehicle

    context.rotate(
        player.angle
    );

    // Vehicle

    context.fillStyle =
        player.carryingPackage
            ? "pink"
            : "blue";

    context.fillRect(
        -player.width / 2,
        -player.height / 2,
        player.width,
        player.height
    );

    // Front of vehicle

    context.fillStyle =
        "white";

    context.fillRect(
        player.width / 2 - 5,
        -player.height / 2,
        5,
        player.height
    );

    context.restore();

}

//recharging//

function rechargePlayer(deltaTime) {

    if (
        !playerInsideChargeZone()
    ) {

        return;

    }

    player.battery +=
        chargeZone.rechargeRate *
        deltaTime;

    player.battery =
        Math.min(
            player.battery,
            player.maxBattery
        );

}

//creating the packages//

const deliveryPackage = {

    x: 200,

    y: 300,

    width: 18,

    height: 18,

    collected: false,

    destination: null

};

//function for where the package should go//

function chooseDeliveryDestination() {

    const index =
        Math.floor(
            Math.random() *
            deliveryPoints.length
        );

    deliveryPackage.destination =
        deliveryPoints[index];

}

//keeps packages spawning in game//

function respawnPackage() {

    chooseDeliveryDestination();

    let validPosition =
        false;

    let attempts = 0;

    const MAX_ATTEMPTS =
        200;

    while (
        !validPosition &&
        attempts < MAX_ATTEMPTS
    ) {

        attempts++;

        deliveryPackage.x =
            Math.random() *
            (
                canvas.width -
                deliveryPackage.width
            );

        deliveryPackage.y =
            Math.random() *
            (
                canvas.height -
                deliveryPackage.height
            );

        validPosition =
            isValidPackagePosition(
                deliveryPackage,
                deliveryPackage.destination
            );

    }

    deliveryPackage.collected =
        false;

}

//drawing the packages//

function drawPackage() {

    if (
        deliveryPackage.collected
    ) {

        return;

    }

    context.fillStyle =
        "pink";

    context.fillRect(
        deliveryPackage.x,
        deliveryPackage.y,
        deliveryPackage.width,
        deliveryPackage.height
    );

    // Package tape

    context.fillStyle =
        "blue";

    context.fillRect(
        deliveryPackage.x + 7,
        deliveryPackage.y,
        4,
        deliveryPackage.height
    );

}

//picking up the package//

function checkPackagePickup() {

    if (
        deliveryPackage.collected ||
        !isColliding(
            player,
            deliveryPackage
        )
    ) {

        return;

    }

    deliveryPackage.collected =
        true;

    player.carryingPackage =
        true;

}

//showing where it must be delivered//

function drawDeliveryPoints() {

    for (
        const point of deliveryPoints
    ) {

        const active =
            deliveryPackage.destination === point &&
            player.carryingPackage;

        // Active destination

        context.fillStyle =
            active
                ? "#00ff66"
                : "gold";

        context.fillRect(
            point.x,
            point.y,
            point.width,
            point.height
        );

        // Border

        context.strokeStyle =
            active
                ? "white"
                : "#333";

        context.lineWidth = 2;

        context.strokeRect(
            point.x,
            point.y,
            point.width,
            point.height
        );

        // Label

        context.fillStyle =
            "black";

        context.font =
            "10px Arial";

        context.textAlign =
            "center";

        context.fillText(
            "DELIVER",
            point.x +
            point.width / 2,
            point.y + 12
        );

        context.textAlign =
            "left";

    }

}

//check if delivered to increase score//

function checkDelivery() {

    if (
        !deliveryPackage.collected ||
        !deliveryPackage.destination
    ) {

        return;

    }

    if (
        isColliding(
            player,
            deliveryPackage.destination
        )
    ) {

        deliveryPackage.collected =
            false;

        player.carryingPackage =
            false;

        score +=
            DELIVERY_SCORE;

        deliveries++;

        respawnPackage();

    }

}

//the hud//

function drawHUD() {

    context.fillStyle =
        "white";

    context.font =
        "20px Arial";

    // Score

    context.fillText(
        `Score: ${score}`,
        20,
        30
    );

    // Time

    context.fillText(
        `Time left: ${Math.ceil(timeRemaining)}`,
        20,
        55
    );

    // Battery label

    context.fillText(
        `Battery: ${Math.ceil(player.battery)}%`,
        20,
        80
    );

    // Battery background

    const batteryX = 150;

    const batteryY = 63;

    const batteryWidth = 150;

    const batteryHeight = 18;

    context.fillStyle =
        "#333";

    context.fillRect(
        batteryX,
        batteryY,
        batteryWidth,
        batteryHeight
    );

    // Battery colour

    if (
        player.battery > 50
    ) {

        context.fillStyle =
            "limegreen";

    }

    else if (
        player.battery > 20
    ) {

        context.fillStyle =
            "orange";

    }

    else {

        context.fillStyle =
            "red";

    }

    // Battery amount

    context.fillRect(
        batteryX,
        batteryY,
        batteryWidth *
        (
            player.battery /
            player.maxBattery
        ),
        batteryHeight
    );

    // Border

    context.strokeStyle =
        "white";

    context.strokeRect(
        batteryX,
        batteryY,
        batteryWidth,
        batteryHeight
    );

}

